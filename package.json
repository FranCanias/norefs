{
  "name": "norefs",
  "version": "0.12.0",
  "description": "Find unused files, exports, and type/object members in a TypeScript project.",
  "type": "commonjs",
  "bin": {
    "norefs": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "!docs/_config.yml",
    "!docs/CNAME",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc && node -e \"require('node:fs').chmodSync('dist/index.js',0o755)\"",
    "check": "biome ci .",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "release": "npm version --message \"chore: release v%s\"",
    "postversion": "git push --follow-tags"
  },
  "keywords": [
    "typescript",
    "dead-code",
    "unused-exports",
    "unused-files",
    "lint",
    "cli",
    "ts-morph"
  ],
  "author": "Fran Cañas",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranCanias/norefs.git"
  },
  "homepage": "https://github.com/FranCanias/norefs#readme",
  "bugs": {
    "url": "https://github.com/FranCanias/norefs/issues"
  },
  "engines": {
    "node": ">=22.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "diff": "9.0.0",
    "minimatch": "10.2.6",
    "ts-morph": "28.0.0"
  }
}
