{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Not verbatimModuleSyntax: under `type: commonjs` it bans ESM import
    // syntax outright (TS1295). Biome's useImportType keeps `import type`
    // honest instead; this keeps each file independently transpilable.
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"]
}
